# Supabase — Phase 0
# Public (client-side) — anon key. Server-only secrets MUST NOT be NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — full DB access. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Cron — shared secret for Vercel Cron auth (Authorization: Bearer <secret>).
# CRON_SECRET is the primary name — Vercel Cron injects it automatically once
# set as a project env var. CRON_SECRET_KEY is a legacy alias also accepted
# (lib/cronAuth.ts checks both, timing-safe). Server-side only.
CRON_SECRET=
CRON_SECRET_KEY=

# Optional — Google Gemini for news summaries. If absent, summaries are skipped.
GEMINI_API_KEY=

# Absolute site URL for server-side (RSC) fetches of our own API routes.
# e.g. https://project-anthology-three.vercel.app (no trailing slash). When unset,
# code falls back to VERCEL_URL (own preview/branch domain), then the hardcoded
# production URL, then localhost. Leave unset on Vercel so previews self-fetch
# their own deployment instead of production.
NEXT_PUBLIC_SITE_URL=

# Vercel OIDC token is written automatically by `vercel env pull` — do not set by hand.
# VERCEL_OIDC_TOKEN=
