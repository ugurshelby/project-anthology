# Supabase — Phase 0
# Public (client-side) — anon key. Server-only secrets MUST NOT be NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — full DB access. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Cron — shared secret for Vercel Cron auth (Authorization: Bearer <secret>).
# CRON_SECRET is the primary name — Vercel Cron injects it automatically once
# set as a project env var. CRON_SECRET_KEY is a legacy alias also accepted
# (lib/cronAuth.ts checks both, timing-safe). Server-side only.
CRON_SECRET=
CRON_SECRET_KEY=

# Optional — news rewrite. Groq is primary, Gemini is the fallback. If both are
# absent, a story keeps its best source's own title/summary.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional — comma-separated model lists overriding the defaults in lib/news/rewrite.ts.
GROQ_NEWS_MODELS=
GEMINI_NEWS_MODELS=

# Optional — OpenF1 paid live access (plan 1.7). Server-only; without them the
# live tracker shows a "locked during the session" state while a session runs.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Optional — distributed rate limit and cron lock (Upstash Redis REST). Without
# them the code falls back to an in-memory limiter (per server instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — Sentry error reporting and source-map upload.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_UPLOAD_SOURCE_MAPS=

# Optional — read by GitHub Actions and scripts/sync-f1-scheduled.ts (set as a
# repo variable there). The site itself uses NEXT_PUBLIC_SITE_URL.
SITE_URL=

# Absolute site URL for server-side (RSC) fetches of our own API routes.
# e.g. https://project-anthology-eight.vercel.app (no trailing slash). When unset,
# code falls back to VERCEL_URL (own preview/branch domain), then the hardcoded
# production URL, then localhost. Leave unset on Vercel so previews self-fetch
# their own deployment instead of production.
NEXT_PUBLIC_SITE_URL=

# Vercel OIDC token is written automatically by `vercel env pull` — do not set by hand.
# VERCEL_OIDC_TOKEN=

# Optional — contact shown in the User-Agent of media-sync requests to Wikimedia (their API policy
# asks for it). Falls back to the site URL when empty.
MEDIA_CONTACT=

# QStash (external scheduler, plan 1.6). The SITE needs only the two signing keys (Vercel, Production): cron routes
# accept QStash's signed requests with them (lib/cronAuth.ts), so schedules carry no CRON_SECRET.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional — only for `npm run qstash:sync` on the owner's machine (not needed in Vercel). QSTASH_URL is the API
# origin shown next to the token in the Upstash console (region specific).
QSTASH_TOKEN=
QSTASH_URL=

# Optional — Search Console ownership token (the content of the verification <meta> tag, HTML-tag method).
GOOGLE_SITE_VERIFICATION=
